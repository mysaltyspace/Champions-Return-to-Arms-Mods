gametitle=Champions: Return to Arms * NTSC-U * SLUS-20973 * 4028A55F
[INT Scaling Static]
author=ported from skeewirt's CoN mod by Claude
description=Spell damage scales with Intelligence. Flat 0.5% per INT above 20. Melee/physical unaffected. 

// ============================================================
// SCALING TABLE (flat 0.5%/pt above INT 20)
//   INT  20: +0%
//   INT  50: +15%
//   INT  70: +25%
//   INT 100: +40%
//   INT 200: +90%
//
// Reads INT from static address 004D8B84.
// Hijacks spell damage at 001E8D0C.
// ============================================================

// ---- HIJACK at 001E8D0C --------------------------------
patch=1,EE,201E8D0C,extended,08236400 // j 0x008D9000
patch=1,EE,201E8D10,extended,00000000 // nop

// ---- DETOUR at 0x008D9000 ------------------------------
// Save registers
patch=1,EE,208D9000,extended,27BDFFF0 // addiu sp,sp,-16
patch=1,EE,208D9004,extended,AFA80000 // sw t0,0(sp)
patch=1,EE,208D9008,extended,AFA90004 // sw t1,4(sp)
patch=1,EE,208D900C,extended,E7A00008 // swc1 f0,8(sp)
patch=1,EE,208D9010,extended,E7A1000C // swc1 f1,12(sp)

// Load INT from static address 004D8B84
patch=1,EE,208D9014,extended,3C09004E // lui t1,0x004E
patch=1,EE,208D9018,extended,25298B84 // addiu t1,t1,0x8B84  -> 004D8B84
patch=1,EE,208D901C,extended,8D280000 // lw t0,0(t1)

// Subtract base INT (20)
patch=1,EE,208D9020,extended,2508FFEC // addiu t0,t0,-20

// bgez: if INT-20 >= 0 jump to compute, else fall to early exit
patch=1,EE,208D9024,extended,05010008 // bgez t0,0x208D9048
patch=1,EE,208D9028,extended,00000000 // nop

// ---- early_exit: restore and return without scaling ----
patch=1,EE,208D902C,extended,8FA80000 // lw t0,0(sp)
patch=1,EE,208D9030,extended,8FA90004 // lw t1,4(sp)
patch=1,EE,208D9034,extended,C7A00008 // lwc1 f0,8(sp)
patch=1,EE,208D9038,extended,C7A1000C // lwc1 f1,12(sp)
patch=1,EE,208D903C,extended,27BD0010 // addiu sp,sp,16
patch=1,EE,208D9040,extended,4600BDC2 // mul.s f23,f23,f0    (displaced)
patch=1,EE,208D9044,extended,0807A345 // j 0x001E8D14        (return)
patch=1,EE,208D9048,extended,8FAC01A4 // lw t4,0x1A4(sp)     (delay slot)

// ---- compute multiplier at 208D904C: INT >= base -------
// Convert INT-above-base to float
patch=1,EE,208D904C,extended,44880000 // mtc1 t0,f0
patch=1,EE,208D9050,extended,46800020 // cvt.s.w f0,f0

// Multiply by 0.005 (0.5% per INT point above base)
patch=1,EE,208D9054,extended,3C093BA3 // lui t1,0x3BA3       // 0.005f hi
patch=1,EE,208D9058,extended,3529D70A // ori t1,t1,0xD70A    // 0.005f lo
patch=1,EE,208D905C,extended,44890800 // mtc1 t1,f1
patch=1,EE,208D9060,extended,46010002 // mul.s f0,f0,f1      // bonus = (INT-20) * 0.005

// Add 1.0 to get final multiplier
patch=1,EE,208D9064,extended,3C093F80 // lui t1,0x3F80       // 1.0f
patch=1,EE,208D9068,extended,44890800 // mtc1 t1,f1
patch=1,EE,208D906C,extended,46000800 // add.s f0,f1,f0      // f0 = 1.0 + bonus

// Apply multiplier to spell damage f23
patch=1,EE,208D9070,extended,4600BDC2 // mul.s f23,f23,f0

// Restore registers
patch=1,EE,208D9074,extended,8FA80000 // lw t0,0(sp)
patch=1,EE,208D9078,extended,8FA90004 // lw t1,4(sp)
patch=1,EE,208D907C,extended,C7A00008 // lwc1 f0,8(sp)
patch=1,EE,208D9080,extended,C7A1000C // lwc1 f1,12(sp)
patch=1,EE,208D9084,extended,27BD0010 // addiu sp,sp,16

// Re-execute displaced instructions and return
patch=1,EE,208D9088,extended,4600BDC2 // mul.s f23,f23,f0    (original 001E8D0C)
patch=1,EE,208D908C,extended,0807A345 // j 0x001E8D14
patch=1,EE,208D9090,extended,8FAC01A4 // lw t4,0x1A4(sp)     (delay slot)

// ============================================================
// CUSTOMIZATION
// ============================================================
// Base INT (208D9020):
//   2508FFEC = 20 (default)   2508FFF6 = 10   25080000 = 0
//   2508FFE2 = 30             2508FFD8 = 40
//
// Coefficient (208D9054/208D9058):
//   3C093A03 / 35290000 = 0.1%/pt
//   3C093A83 / 35290000 = 0.2%/pt
//   3C093B03 / 35290000 = 0.3%/pt
//   3C093B83 / 3529126F = 0.4%/pt
//   3C093BA3 / 3529D70A = 0.5%/pt  (default)
//   3C093C23 / 35290000 = 1.0%/pt
// ============================================================
