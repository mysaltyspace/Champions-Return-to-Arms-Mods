gametitle=Champions: Return to Arms * NTSC-U * SLUS-20973 * 4028A55F
[INT Scaling]
author=mysaltyspace (inspired by skeewirt's CoN mod, made by Claude code)
description=All spell damage (direct, AoE, DoT, beam) scales with the caster's INT. Diminishing returns: 0.5%/pt up to 100, 0.4%/pt up to 200, 0.3%/pt up to 300, 0.2%/pt beyond. 1-4 players each use their own INT. Physical/melee and weapon enchantment elemental unaffected.

// ============================================================
// SCALING TABLE (spell damage multiplier bonus)
//   INT  20: +0%    (base threshold, no bonus below)
//   INT  50: +15%
//   INT  63: +21.5%
//   INT 100: +40%
//   INT 150: +60%
//   INT 200: +80%
//   INT 300: +110%
//   INT 400: +130%
// ============================================================

// ============================================================
// HOOK 5 — Universal spell damage (001EA6C4)
//
// WHY THIS POINT:
//   z_un_001e8230 handles all damage. Physical damage (melee/arrows)
//   takes the bit-5-CLEAR path and exits unconditionally at 001E84B0
//   before ever reaching 001EA6C4.
//
//   All spell damage (bit-5-SET path) converges at 001EA6C4 just
//   before the final HP-reduction vtable call. At this point:
//     f23 = final computed spell damage (float)
//     f20 = 0.5  (loaded at 001EA6B0 for rounding)
//
// AUTO-ATTACK / PHYSICAL GUARD:
//   Staff auto-attacks and weapon attacks (blunt, slashing, ranged)
//   also reach 001EA6C4 via the spell path. They must NOT be scaled.
//   Discriminant: flags word at original sp+0x1A4.
//   Mask 0x40040004 catches all physical types:
//     Blunt melee:      0x00040001  & 0x40040004 = 0x00040000  -> skip
//     Slashing:         0x00040008  & 0x40040004 = 0x00040000  -> skip
//     Ranged:           0x00000004  & 0x40040004 = 0x00000004  -> skip
//     Cyclone (slash):  0x40080008  & 0x40040004 = 0x40000000  -> skip
//     Cyclone (blunt):  0x40080001  & 0x40040004 = 0x40000000  -> skip
//     All spells/Roar:  0x00000000..0x00080940  & 0x40240004 = 0  -> scale
//   Observed flag values at 001EA6C4:
//     Bolt of Shock:    0x00000040  -> scale
//     Shock of Frost:   0x00000000  -> scale
//     Cone of Fire:     0x00000040  -> scale
//     Cone of Frost:    0x0080C040  -> scale
//     Wizard Beam:      0x00000100  -> scale
//     Roar (AoE):       0x00080940  -> scale
//     Shield Bash Lv1-5:  0x00040040  -> skip (bit 18+6)
//     Shield Bash Lv6-16: 0x00080040  -> skip (bit 19+6, gains multi-target)
//     Shield Bash Lv17+:  0x00200040  -> skip (bit 21+6, gains push-back)
//   Guard: if (flags & 0x402C0004) != 0, branch to 008D9990.
//   NOTE: Roar (0x00080940) has bit 19 and is caught by this guard. At 008D9990
//   it is identified by bits 11+8 (0x0900) which no SB variant has, then
//   redirected to INT scaling (008D9834) so it is not incorrectly suppressed.
//   If Shield Bash Defense Scaling is enabled, 008D9990 contains
//   Shield Bash detection + armor scaling, then falls through to
//   restore. If only INT Scaling is enabled, 008D9990 is a
//   passthrough j directly to restore (008D996C).
//   After sp-=24 inside detour, flags word is at sp+0x1BC.
//   Mask loaded via lui/ori into t1, then AND with t0 (flags).
//
// INT LOOKUP:
//   player_index computed from s4 entity slot drives a stride formula
//   (stride 0x4C30) to find each player's INT address. Verified:
//     index 0 (entity 0x006C88C0): INT at 0x004D8B84
//     index 1 (entity 0x006C9478): INT at 0x004DD7B4
//     index 2 (entity 0x006CA030): INT at 0x004E23E4
//     index 3 (entity 0x006CABE8): INT at 0x004E7014
//   Single-player quirk: character class fixes entity slot (e.g. Shaman
//   always uses slot 2), but stat blocks 1-3 are zero in single-player.
//   Zero-check fallback at 008D9A24 handles this: if lw returns 0, fall
//   back to slot 0 (0x004D8B84) which always holds the active character's INT.
//   s4 entity slot is also used by the entity guard (sltiu < 4) to
//   reject world entity sources (poison clouds, etc.).
//
// ENTITY GUARD:
//   Persistent world entities (e.g. poison cloud DoT sources) reach
//   001EA6C4 with s4 pointing to the entity, not a player. The
//   player_index formula produces garbage -> random memory read ->
//   millions of damage.
//   Fix: sltiu check after mflo. If player_index >= 4, skip scaling.
//
// ORIGINAL:  add.s f00,f23,f20   (4614B800)
//   Rounds f23 for int conversion, result in f0 for cvt.w.s.
//
// AFTER HOOK: f23 scaled by INT bonus first, then displaced add.s
//   runs in delay slot -> f0 = scaled_f23 + 0.5.
//   Execution resumes at 001EA6CC (cvt.w.s f01,f00).
//
// PREVIOUS HOOKS (all removed):
//   Hook 1 (001E8D0C): gated by blez s7 — missed Shock of Frost
//   Hook 2 (001EA890): never triggered (confirmed dead)
//   Hook 3 (001EA7B8): f23=0.0 at that point (zeroed at 001EA6F8)
//   Hook 4 (001E8494): physical path — unintentionally scaled melee
// ============================================================

// ---- HIJACK at 001EA6C4 --------------------------------
patch=1,EE,201EA6C4,extended,08236600 // j 0x008D9800  (was: add.s f00,f23,f20 = 4614B800)
// delay slot 001EA6C8 (02A0202D  daddu a0,s5,zero) runs unchanged

// ---- DETOUR at 0x008D9800 ------------------------------
// Entry state: f23=spell damage, f20=0.5 (must not clobber)
// f0 free (overwritten by displaced add.s at return)
// Saves: at, t0, t1, f1, f2, f3 via 24-byte stack frame
// Reads s4 (per-player entity pointer) without saving — read-only

// Save registers
patch=1,EE,208D9800,extended,27BDFFE8 // addiu sp,sp,-24
patch=1,EE,208D9804,extended,AFA10000 // sw at,0(sp)
patch=1,EE,208D9808,extended,AFA80004 // sw t0,4(sp)
patch=1,EE,208D980C,extended,AFA90008 // sw t1,8(sp)
patch=1,EE,208D9810,extended,E7A1000C // swc1 f1,12(sp)
patch=1,EE,208D9814,extended,E7A20010 // swc1 f2,16(sp)
patch=1,EE,208D9818,extended,E7A30014 // swc1 f3,20(sp)

// ---- Guard: skip INT scaling for all physical attacks --
// original sp+0x1A4 = current sp+0x1BC  (sp decremented by 24 = 0x18)
// mask 0x40040004: bit 30=melee-AoE(Cyclone) bit 18=melee(blunt/slash) bit 2=ranged
//   Blunt:          0x00040001 & 0x40040004 = 0x00040000 != 0 -> skip
//   Slashing:       0x00040008 & 0x40040004 = 0x00040000 != 0 -> skip
//   Ranged:         0x00000004 & 0x40040004 = 0x00000004 != 0 -> skip
//   Cyclone(slash): 0x40080008 & 0x40040004 = 0x40000000 != 0 -> skip
//   Cyclone(blunt): 0x40080001 & 0x40040004 = 0x40000000 != 0 -> skip
//   Spells/Roar:    any        & 0x40040004 = 0            -> scale
// bne target: 008D9990 (Shield Bash passthrough / Shield Bash scaling entry)
// bne offset: (008D9990 - 008D982C - 4) / 4 = 0x160/4 = 0x58
patch=1,EE,208D981C,extended,8FA801BC // lw t0,0x1BC(sp)       load flags word
patch=1,EE,208D9820,extended,3C09402C // lui t1,0x402C         mask hi: bits 30+21+19+18
patch=1,EE,208D9824,extended,35290004 // ori t1,t1,0x0004      mask lo: bit 2  -> t1=0x402C0004
patch=1,EE,208D9828,extended,01094024 // and t0,t0,t1          t0 = flags & mask
patch=1,EE,208D982C,extended,15000058 // bne t0,zero,008D9990  if any phys bit set -> 008D9990
patch=1,EE,208D9830,extended,00000000 // nop

// ---- Player entity validation + INT load ----------------
// player_index = (s4 - 0x006C88C0) / 0x0BB8   -> {0,1,2,3}
// Used by entity guard (sltiu < 4) AND by stride formula below.
// Verified INT addresses (stride 0x4C30):
//   index 0 (entity 0x006C88C0): INT at 0x004D8B84
//   index 1 (entity 0x006C9478): INT at 0x004DD7B4
//   index 2 (entity 0x006CA030): INT at 0x004E23E4
//   index 3 (entity 0x006CABE8): INT at 0x004E7014
// Single-player quirk: character class sets entity slot (e.g. Shaman
//   always loads into entity slot 2 even in a solo session), but stat
//   blocks 1-3 are zero in single-player. Zero-check fallback at
//   008D9A24 catches this and reads from block 0 (0x004D8B84) instead.
// Extended INT logic at 008D9A24; j at 208D9858 trampolines there.
patch=1,EE,208D9834,extended,3C09006C // lui t1,0x006C         P1 s4 base [hi]
patch=1,EE,208D9838,extended,352988C0 // ori t1,t1,0x88C0      t1 = 0x006C88C0
patch=1,EE,208D983C,extended,02894023 // subu t0,s4,t1         t0 = s4 - P1_base
patch=1,EE,208D9840,extended,34090BB8 // ori t1,zero,0x0BB8    t1 = s4 stride (3000)
patch=1,EE,208D9844,extended,0109001B // divu t0,t1            LO = player_index
patch=1,EE,208D9848,extended,00004012 // mflo t0               t0 = player_index {0,1,2,3}

// ---- Entity guard: skip if s4 is not a player entity ----
// Persistent world entities (poison clouds, etc.) set s4 to the
// entity address, not a player -> player_index is garbage -> random
// INT read -> millions of damage.
// sltiu: at=1 if t0 < 4 (valid index), at=0 otherwise.
// beq: if at==0 (invalid), branch directly to restore (008D996C).
// Direct restore avoids a potential loop when a world entity has Roar-like flags
// (bit 19+6+11+8) and the inner check would redirect back to INT scaling.
// beq offset: (008D996C - 008D9850 - 4) / 4 = 0x118/4 = 0x46
patch=1,EE,208D984C,extended,2D010004 // sltiu at,t0,4         at=1 if valid player index
patch=1,EE,208D9850,extended,10200046 // beq at,zero,008D996C  if invalid entity -> restore
patch=1,EE,208D9854,extended,00000000 // nop

patch=1,EE,208D9858,extended,08236689 // j 008D9A24             -> extended INT lookup
patch=1,EE,208D985C,extended,00000000 // nop
patch=1,EE,208D9860,extended,00000000 // nop (dead)
patch=1,EE,208D9864,extended,00000000 // nop (dead)
patch=1,EE,208D9868,extended,00000000 // nop (dead)
patch=1,EE,208D986C,extended,00000000 // nop (dead)
patch=1,EE,208D9870,extended,00000000 // nop (dead)

// Convert INT to float -> f2
patch=1,EE,208D9874,extended,44880000 // mtc1 t0,f0
patch=1,EE,208D9878,extended,46800020 // cvt.s.w f0,f0
patch=1,EE,208D987C,extended,46000086 // mov.s f2,f0           f2 = float(INT)
patch=1,EE,208D9880,extended,44800000 // mtc1 zero,f0          f0 = 0.0 (bonus accumulator)

// ---- TIER 1: INT 20-100, +0.5%/pt (max +40%) ----------
patch=1,EE,208D9884,extended,3C0942C8 // lui t1,0x42C8         100.0f
patch=1,EE,208D9888,extended,44890800 // mtc1 t1,f1
patch=1,EE,208D988C,extended,460110E9 // min.s f3,f2,f1        f3 = min(INT,100)
patch=1,EE,208D9890,extended,3C0941A0 // lui t1,0x41A0         20.0f
patch=1,EE,208D9894,extended,44890800 // mtc1 t1,f1
patch=1,EE,208D9898,extended,460118C1 // sub.s f3,f3,f1        f3 = min(INT,100) - 20
patch=1,EE,208D989C,extended,46030034 // c.lt.s f0,f3
patch=1,EE,208D98A0,extended,45000006 // bc1f +6 -> 008D98BC   skip if INT<=20
patch=1,EE,208D98A4,extended,00000000 // nop
patch=1,EE,208D98A8,extended,3C093BA3 // lui t1,0x3BA3         0.005f hi
patch=1,EE,208D98AC,extended,3529D70A // ori t1,t1,0xD70A      0.005f lo  (3BA3D70A)
patch=1,EE,208D98B0,extended,44890800 // mtc1 t1,f1
patch=1,EE,208D98B4,extended,460118C2 // mul.s f3,f3,f1        pts_in_t1 * 0.005
patch=1,EE,208D98B8,extended,46030000 // add.s f0,f0,f3        accumulate
// skip_t1: 008D98BC

// ---- TIER 2: INT 100-200, +0.4%/pt (max +40%) ---------
patch=1,EE,208D98BC,extended,3C094348 // lui t1,0x4348         200.0f
patch=1,EE,208D98C0,extended,44890800 // mtc1 t1,f1
patch=1,EE,208D98C4,extended,460110E9 // min.s f3,f2,f1        f3 = min(INT,200)
patch=1,EE,208D98C8,extended,3C0942C8 // lui t1,0x42C8         100.0f
patch=1,EE,208D98CC,extended,44890800 // mtc1 t1,f1
patch=1,EE,208D98D0,extended,460118C1 // sub.s f3,f3,f1        f3 = min(INT,200) - 100
patch=1,EE,208D98D4,extended,46030034 // c.lt.s f0,f3
patch=1,EE,208D98D8,extended,45000006 // bc1f +6 -> 008D98F4   skip if INT<=100
patch=1,EE,208D98DC,extended,00000000 // nop
patch=1,EE,208D98E0,extended,3C093B83 // lui t1,0x3B83         0.004f hi
patch=1,EE,208D98E4,extended,3529126F // ori t1,t1,0x126F      0.004f lo  (3B83126F)
patch=1,EE,208D98E8,extended,44890800 // mtc1 t1,f1
patch=1,EE,208D98EC,extended,460118C2 // mul.s f3,f3,f1        pts_in_t2 * 0.004
patch=1,EE,208D98F0,extended,46030000 // add.s f0,f0,f3        accumulate
// skip_t2: 008D98F4

// ---- TIER 3: INT 200-300, +0.3%/pt (max +30%) ---------
patch=1,EE,208D98F4,extended,3C094396 // lui t1,0x4396         300.0f
patch=1,EE,208D98F8,extended,44890800 // mtc1 t1,f1
patch=1,EE,208D98FC,extended,460110E9 // min.s f3,f2,f1        f3 = min(INT,300)
patch=1,EE,208D9900,extended,3C094348 // lui t1,0x4348         200.0f
patch=1,EE,208D9904,extended,44890800 // mtc1 t1,f1
patch=1,EE,208D9908,extended,460118C1 // sub.s f3,f3,f1        f3 = min(INT,300) - 200
patch=1,EE,208D990C,extended,46030034 // c.lt.s f0,f3
patch=1,EE,208D9910,extended,45000006 // bc1f +6 -> 008D992C   skip if INT<=200
patch=1,EE,208D9914,extended,00000000 // nop
patch=1,EE,208D9918,extended,3C093B44 // lui t1,0x3B44         0.003f hi
patch=1,EE,208D991C,extended,35299BA6 // ori t1,t1,0x9BA6      0.003f lo  (3B449BA6)
patch=1,EE,208D9920,extended,44890800 // mtc1 t1,f1
patch=1,EE,208D9924,extended,460118C2 // mul.s f3,f3,f1        pts_in_t3 * 0.003
patch=1,EE,208D9928,extended,46030000 // add.s f0,f0,f3        accumulate
// skip_t3: 008D992C

// ---- TIER 4: INT 300+, +0.2%/pt (no cap) --------------
patch=1,EE,208D992C,extended,460010C6 // mov.s f3,f2           f3 = float(INT)
patch=1,EE,208D9930,extended,3C094396 // lui t1,0x4396         300.0f
patch=1,EE,208D9934,extended,44890800 // mtc1 t1,f1
patch=1,EE,208D9938,extended,460118C1 // sub.s f3,f3,f1        f3 = INT - 300
patch=1,EE,208D993C,extended,46030034 // c.lt.s f0,f3
patch=1,EE,208D9940,extended,45000006 // bc1f +6 -> 008D995C   skip if INT<=300
patch=1,EE,208D9944,extended,00000000 // nop
patch=1,EE,208D9948,extended,3C093B03 // lui t1,0x3B03         0.002f hi
patch=1,EE,208D994C,extended,3529126F // ori t1,t1,0x126F      0.002f lo  (3B03126F)
patch=1,EE,208D9950,extended,44890800 // mtc1 t1,f1
patch=1,EE,208D9954,extended,460118C2 // mul.s f3,f3,f1        pts_above_300 * 0.002
patch=1,EE,208D9958,extended,46030000 // add.s f0,f0,f3        accumulate
// skip_t4: 008D995C

// ---- Apply multiplier to f23 ---------------------------
patch=1,EE,208D995C,extended,3C093F80 // lui t1,0x3F80         1.0f
patch=1,EE,208D9960,extended,44890800 // mtc1 t1,f1
patch=1,EE,208D9964,extended,46000800 // add.s f0,f1,f0        f0 = 1.0 + bonus
patch=1,EE,208D9968,extended,4600BDC2 // mul.s f23,f23,f0      scale spell damage

// ---- Restore registers ---------------------------------
// NOTE: guard bne (008D982C) and entity guard beq (008D9850) both
//       branch to 008D9990. If Shield Bash section is disabled that
//       is a passthrough j here. If enabled, Shield Bash scaling runs
//       first, then falls through here.
patch=1,EE,208D996C,extended,8FA10000 // lw at,0(sp)
patch=1,EE,208D9970,extended,8FA80004 // lw t0,4(sp)
patch=1,EE,208D9974,extended,8FA90008 // lw t1,8(sp)
patch=1,EE,208D9978,extended,C7A1000C // lwc1 f1,12(sp)
patch=1,EE,208D997C,extended,C7A20010 // lwc1 f2,16(sp)
patch=1,EE,208D9980,extended,C7A30014 // lwc1 f3,20(sp)
patch=1,EE,208D9984,extended,27BD0018 // addiu sp,sp,24

// ---- Return: displaced instruction runs as delay slot --
// j 0x001EA6CC; delay slot: add.s f00,f23,f20  (4614B800)
// -> f0 = (scaled) f23 + 0.5, correctly rounds for cvt.w.s at 001EA6CC
patch=1,EE,208D9988,extended,0807A9B3 // j 0x001EA6CC
patch=1,EE,208D998C,extended,4614B800 // add.s f00,f23,f20     (displaced, runs as delay slot)

// ---- Passthrough at 008D9990 (overwritten when Shield Bash section enabled) --
// When only INT Scaling is checked, attacks with bit 19/21/18/30/2 land here.
// We can't restore blindly — Roar (bit 19+6+11+8) and Holy Strike (bit 19 only)
// must still INT scale. Jump to dispatch at 008D9B00 to sort them out.
patch=1,EE,208D9990,extended,082366C0 // j 008D9B00            -> Holy Strike / physical dispatch
patch=1,EE,208D9994,extended,00000000 // nop

// ============================================================
// EXTENDED INT LOOKUP at 008D9A24
//
// Entered via j from 208D9858 with t0 = player_index (0-3).
// Computes INT address via stride formula; if the stat block is
// zero (single-player char in entity slot 2-4), falls back to
// slot 0 (0x004D8B84) which always holds the active character's INT.
//
// bne offset: (008D9874 - 008D9A44) / 4 = -0x1D0/4 = -0x74 = 0xFF8C
// j return:   008D9874 = 0x0823661D
// ============================================================
patch=1,EE,208D9A24,extended,34094C30 // ori t1,zero,0x4C30    INT stride
patch=1,EE,208D9A28,extended,01090019 // multu t0,t1           index * stride
patch=1,EE,208D9A2C,extended,00004012 // mflo t0               byte offset
patch=1,EE,208D9A30,extended,3C09004E // lui t1,0x004E         P1 INT base [hi]
patch=1,EE,208D9A34,extended,25298B84 // addiu t1,t1,0x8B84    t1 = 0x004D8B84
patch=1,EE,208D9A38,extended,01094021 // addu t0,t0,t1         t0 = INT address
patch=1,EE,208D9A3C,extended,8D080000 // lw t0,0(t0)           t0 = INT value
patch=1,EE,208D9A40,extended,1500FF8C // bne t0,zero,008D9874  non-zero: use it
patch=1,EE,208D9A44,extended,3C09004E // [delay slot] lui t1,0x004E  (runs always)
// fallback: stat block was empty (single-player, non-slot-0 entity)
patch=1,EE,208D9A48,extended,25298B84 // addiu t1,t1,0x8B84    t1 = 0x004D8B84
patch=1,EE,208D9A4C,extended,8D280000 // lw t0,0(t1)           t0 = slot-0 INT
patch=1,EE,208D9A50,extended,0823661D // j 008D9874
patch=1,EE,208D9A54,extended,00000000 // nop

// ============================================================
// HOLY STRIKE / PHYSICAL DISPATCH at 008D9B00
//
// Reached from:
//   - Passthrough at 008D9990 (INT Scaling only, no Shield Bash)
//   - beq at 208D9998 in Shield Bash section (bit 6 not set)
//
// t0 may be stale (masked flags from outer guard AND). Reloads fresh.
//
// Dispatch:
//   bit 6 set + bits 11+8 set  -> Roar       -> INT scaling (008D9874)
//   bit 6 set + bits 11+8 clr  -> SB Lv6-16  -> restore (no armor scaling in INT-only mode)
//   bit 6 clr + bits 30/18/2   -> physical   -> restore
//   bit 6 clr + no 30/18/2     -> Holy Strike -> INT scaling (008D9874)
//
// bne Roar offset:  (008D9834 - (008D9B10+4)) / 4 = -0x2E0/4 = -0xB8 = 0xFF48
// bne phys offset:  (008D9B40 - (008D9B30+4)) / 4 = +0x0C/4  = +3    = 0x0003
// ============================================================
patch=1,EE,208D9B00,extended,8FA801BC // lw t0,0x1BC(sp)           reload flags
patch=1,EE,208D9B04,extended,31090040 // andi t1,t0,0x0040          t1 = bit 6
patch=1,EE,208D9B08,extended,11200006 // beq t1,zero,008D9B24       no bit 6 -> physical/HS check
patch=1,EE,208D9B0C,extended,31090900 // [delay slot] andi t1,t0,0x0900  t1 = bits 11+8
// bit 6 set: Roar or SB Lv6-16
patch=1,EE,208D9B10,extended,1520FF48 // bne t1,zero,008D9834       Roar -> INT scaling (load INT first)
patch=1,EE,208D9B14,extended,00000000 // nop
patch=1,EE,208D9B18,extended,0823665B // j 008D996C                 SB Lv6-16 -> restore
patch=1,EE,208D9B1C,extended,00000000 // nop (delay slot)
// no bit 6: check physical bits (30+18+2) in original flags
patch=1,EE,208D9B24,extended,3C094004 // lui t1,0x4004              bits 30+18 hi
patch=1,EE,208D9B28,extended,35290004 // ori t1,t1,0x0004           t1 = 0x40040004 (bits 30+18+2)
patch=1,EE,208D9B2C,extended,01094024 // and t0,t0,t1               t0 = flags & physical_mask
patch=1,EE,208D9B30,extended,15000003 // bne t0,zero,008D9B40       physical bits set -> restore
patch=1,EE,208D9B34,extended,00000000 // nop
patch=1,EE,208D9B38,extended,0823660D // j 008D9834                 Holy Strike -> INT scaling (load INT first)
patch=1,EE,208D9B3C,extended,00000000 // nop (delay slot)
patch=1,EE,208D9B40,extended,0823665B // j 008D996C                 physical -> restore
patch=1,EE,208D9B44,extended,00000000 // nop (delay slot)

[Shield Bash Defense Scaling]
author=mysaltyspace (made by Claude code)
description=Shield Bash damage scales with total armor. Formula: damage = (base+10+0.04*armor) * (1.7+0.0015*armor). Flat +10 and x1.7 base give early-game bump; armor terms reward defense builds. Requires INT Scaling checkbox to also be enabled.

// ============================================================
// SHIELD BASH DEFENSE SCALING at 008D9990
//
// The INT Scaling guard and entity guard branch to 008D9990 for all
// physical attacks. This section overwrites the INT Scaling passthrough
// with real Shield Bash detection and armor scaling.
//
// DETECTION:
//   Shield Bash flags confirmed: 0x00200040 (bit 21 + bit 6)
//   Bit 21 (0x00200000) is unique to Shield Bash among all observed attacks.
//   Other physical attacks (blunt/slash/ranged/Cyclone) have bits 18/30/2 but NOT bit 21.
//   Spells have bit 6 but NOT bit 21.
//   Outer guard updated to 0x40240004 (added bit 21) to route SB to this section.
//   Inner check: if (flags & 0x00200000) == 0 -> not Shield Bash -> restore
//
// ARMOR SOURCE:
//   Total armor stored as halfword at entity_base+0xE4 (= s4+0xE4).
//   s4 is already the per-player entity base (validated by INT Scaling
//   entity guard before reaching here).
//   Player 1: 0x006C89A4
//
// FORMULA:
//   damage = (base + 10 + 0.04*armor) * (1.7 + 0.0015*armor)
//   Left  = f1 = base + 10 + 0.04*armor
//   Right = f2 = 1.7 + 0.0015*armor
//   f23   = f1 * f2
//   Constants:
//     0.04f   = 0x3D23D70A  (same mantissa as game's 0.01f, exponent +2)
//     10.0f   = 0x41200000
//     0.0015f = 0x3AC49BA6
//     1.7f    = 0x3FD9999A
//
// SCALING TABLE (SB Lv20 base ~125, total armor):
//   armor    0: damage =  230  (135 x 1.70)
//   armor  200: damage =  286  (143 x 2.00)
//   armor  400: damage =  347  (151 x 2.30)
//   armor  524: damage =  388  (156 x 2.49)  <- typical endgame
//   armor  800: damage =  484  (167 x 2.90)
//   armor 1000: damage =  560  (175 x 3.20)
//   armor 2000: damage = 1011  (215 x 4.70)
//   armor 3000: damage = 1581  (255 x 6.20)
//
// REGISTER USE:
//   f0 = (float)armor  (scratch, safe: overwritten by displaced add.s at return)
//   f1 = left side temp  (saved/restored by INT Scaling prologue)
//   f2 = right side temp (saved/restored by INT Scaling prologue)
//   f3 = 1.7f constant   (saved/restored by INT Scaling prologue)
//   t0, t1, at = saved/restored by INT Scaling prologue
// ============================================================

// ---- Shield Bash detection -----------------------------
// Reload flags (sp was decremented by 0x18 in INT Scaling prologue)
// 3-way check using delay slot trick:
//   No bit 6 (0x40)       -> regular physical attack -> restore
//   Bit 6 + bits 11+8     -> Roar (spell caught by outer guard) -> INT scaling (008D9834)
//   Bit 6 + no bits 11+8  -> Shield Bash (any level)  -> armor scaling
//
// beq offset: (008D9B00 - (008D9998+4)) / 4 = +0x164/4 = +89 = 0x0059
// bne offset: (008D9834 - (008D99A0+4)) / 4 = -0x170/4 = -92 = 0xFFA4
patch=1,EE,208D9990,extended,8FA801BC // lw t0,0x1BC(sp)         reload flags word
patch=1,EE,208D9994,extended,31090040 // andi t1,t0,0x0040        t1 = flags & bit6
patch=1,EE,208D9998,extended,11200059 // beq t1,zero,008D9B00     no bit6 -> Holy Strike dispatch
patch=1,EE,208D999C,extended,31090900 // [delay slot] andi t1,t0,0x0900  t1 = flags & (bit11+8)
patch=1,EE,208D99A0,extended,1520FFA4 // bne t1,zero,008D9834     Roar bits set -> INT scaling
patch=1,EE,208D99A4,extended,00000000 // nop (delay slot, fall through -> Shield Bash)

// ---- Re-check entity is a valid player (safety) --------
// beq offset: (008D996C - 008D99C4 - 4) / 4 = -0x5C/4 = -23 = 0xFFE9
patch=1,EE,208D99A8,extended,3C09006C // lui t1,0x006C
patch=1,EE,208D99AC,extended,352988C0 // ori t1,t1,0x88C0      t1 = 0x006C88C0
patch=1,EE,208D99B0,extended,02894023 // subu t0,s4,t1         t0 = s4 - P1_base
patch=1,EE,208D99B4,extended,34090BB8 // ori t1,zero,0x0BB8    t1 = stride
patch=1,EE,208D99B8,extended,0109001B // divu t0,t1
patch=1,EE,208D99BC,extended,00004012 // mflo t0               player_index
patch=1,EE,208D99C0,extended,2D010004 // sltiu at,t0,4         at=1 if valid
patch=1,EE,208D99C4,extended,1020FFE9 // beq at,zero,008D996C  if invalid -> restore
patch=1,EE,208D99C8,extended,00000000 // nop

// ---- Load total armor and convert to float -------------
patch=1,EE,208D99CC,extended,968800E4 // lhu t0,0xE4(s4)       total armor (halfword unsigned)
patch=1,EE,208D99D0,extended,44880000 // mtc1 t0,f0
patch=1,EE,208D99D4,extended,46800020 // cvt.s.w f0,f0         f0 = (float)armor

// ---- Left side: f1 = base + 10 + 0.04*armor -----------
patch=1,EE,208D99D8,extended,3C083D23 // lui t0,0x3D23         0.04f hi
patch=1,EE,208D99DC,extended,3508D70A // ori t0,t0,0xD70A      0.04f lo  (3D23D70A)
patch=1,EE,208D99E0,extended,44880800 // mtc1 t0,f1            f1 = 0.04f
patch=1,EE,208D99E4,extended,46010042 // mul.s f1,f0,f1        f1 = armor * 0.04
patch=1,EE,208D99E8,extended,4601B840 // add.s f1,f23,f1       f1 = base + armor*0.04
patch=1,EE,208D99EC,extended,3C084120 // lui t0,0x4120         10.0f (= 0x41200000, no ori needed)
patch=1,EE,208D99F0,extended,44881000 // mtc1 t0,f2            f2 = 10.0f
patch=1,EE,208D99F4,extended,46020840 // add.s f1,f1,f2        f1 = base + 10 + 0.04*armor

// ---- Right side: f2 = 1.7 + 0.0015*armor --------------
patch=1,EE,208D99F8,extended,3C083AC4 // lui t0,0x3AC4         0.0015f hi
patch=1,EE,208D99FC,extended,35089BA6 // ori t0,t0,0x9BA6      0.0015f lo  (3AC49BA6)
patch=1,EE,208D9A00,extended,44881000 // mtc1 t0,f2            f2 = 0.0015f
patch=1,EE,208D9A04,extended,46020082 // mul.s f2,f0,f2        f2 = armor * 0.0015
patch=1,EE,208D9A08,extended,3C083FD9 // lui t0,0x3FD9         1.7f hi
patch=1,EE,208D9A0C,extended,3508999A // ori t0,t0,0x999A      1.7f lo  (3FD9999A)
patch=1,EE,208D9A10,extended,44881800 // mtc1 t0,f3            f3 = 1.7f
patch=1,EE,208D9A14,extended,46031080 // add.s f2,f2,f3        f2 = 1.7 + 0.0015*armor

// ---- Final multiply ------------------------------------
patch=1,EE,208D9A18,extended,46020DC2 // mul.s f23,f1,f2       f23 = left * right

// ---- Jump to restore -----------------------------------
patch=1,EE,208D9A1C,extended,0823665B // j 008D996C            -> restore registers + return
patch=1,EE,208D9A20,extended,00000000 // nop
